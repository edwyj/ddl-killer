# DDL Killer 运行所需的环境变量。
#
# 自部署用法见 docs/self-hosting.md；本地 Compose 使用 .env.self-host。
# .env 和 .env.self-host 均已被 .gitignore 忽略；本文件只放占位符，可以入库。

# 会话 token 的 HS256 签名密钥。
# 生产环境要求：至少 32 个字符，且不能是 'dev-secret-change-me'
# （backend/src/security.js 启动时会校验，不满足直接拒绝启动）。
# 生成一个：openssl rand -hex 32
JWT_SECRET=

# MCP PAT / OAuth 令牌的 HMAC pepper，必须与 JWT_SECRET 分开。
# 生成一个：openssl rand -hex 32
MCP_TOKEN_PEPPER=

# 用户自带 AI Key 的 AES-256-GCM 主密钥环。必须独立于 JWT/MCP 密钥。
# 第一项用于新加密，后续项仅用于解密旧数据；轮换完成前不得删除旧版本。
# 生成 32 字节 base64 密钥：openssl rand -base64 32
AI_KEY_ENCRYPTION_KEYS=v1:<base64-32-bytes>

# 官方 DeepSeek 测试额度。完成生产安全验收前保持关闭。
AI_FEATURE_ENABLED=false
AI_HOSTED_ENABLED=false
AI_HOSTED_DAILY_LIMIT=3
# 全站每日上限必须根据预算设置为正整数。
AI_HOSTED_GLOBAL_DAILY_LIMIT=
AI_HOSTED_MODEL=deepseek-flash
# 官方服务专用 DeepSeek Key，仅放生产环境文件，不进入数据库。
AI_HOSTED_DEEPSEEK_KEY=
AI_HOSTED_GLOBAL_ATTEMPT_LIMIT=300
AI_HOSTED_TOKEN_DAILY_LIMIT=3000000
AI_FAILURE_COOLDOWN_SECONDS=30
REFERRAL_MONTHLY_LIMIT=5

# 可选：对外访问源，用于登录时的 Origin 校验，默认 https://ddlkiller.com
# PUBLIC_ORIGIN=
# LEGACY_PUBLIC_ORIGIN=

# Speech service, real key belongs in private deployment env
ASR_ENABLED=false
ASR_SILICONFLOW_KEY=
ASR_USER_DAILY_SECONDS=600
ASR_GLOBAL_DAILY_SECONDS=3600

# 邮箱验证码发信（腾讯云 SES 中国香港 ap-hongkong）。
# 必需配置全部填齐才会启用邮箱服务；缺任意一项即视为未启用，
# 注册、绑定邮箱、找回密码会返回 503，其他功能不受影响。
# 注册/绑定/找回需要发信域名与发信地址已在腾讯云验证、模板已审核通过。
# 建议用只授权 ses:SendEmail 的 CAM 子用户，凭据只放服务器私密文件。
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
# 目前只支持 ap-hongkong 与 ap-guangzhou，其他值视为未配置。
TENCENT_SES_REGION=
# 纯邮箱地址，不带显示名。
TENCENT_SES_FROM=
# 五个模板 ID，均为纯数字。
TENCENT_SES_TEMPLATE_REGISTER=
TENCENT_SES_TEMPLATE_BIND=
TENCENT_SES_TEMPLATE_RESET=
TENCENT_SES_TEMPLATE_PASSWORD_CHANGED=
TENCENT_SES_TEMPLATE_EMAIL_CHANGED=
# 全站每日发信上限；留空时默认正式 300、Beta 40。
EMAIL_DAILY_LIMIT=

# 仅 Beta：逗号分隔的允许收件人。填了就只给这些地址发信，
# 正式环境必须留空，否则真实用户收不到验证码。
BETA_EMAIL_RECIPIENTS=
